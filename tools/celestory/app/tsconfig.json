{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "dom", "dom.iterable"],
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "outDir": "./dist",
    "paths": {
      "@db-astro-suite/theme": ["../../../libs/theme/tokens.css"],
      "@db-astro-suite/ui": ["../../../libs/ui/index.ts"]
    },
    "types": ["vitest/globals", "node"]
  },
  "include": ["src/**/*.ts"]
}
