# Copy to .env.local and fill in your Neon connection string.
# .env.local is gitignored — never commit real credentials.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Public origin (server): shareable story URLs, robots.txt and sitemap.xml.
# Production: https://celestory.dbastrosuite.com — leave unset locally to
# follow the request host.
CELESTORY_PUBLIC_BASE_URL=

# Public origin (browser, baked in at build time): canonical links, og:url /
# og:image and copied profile links. Production: https://celestory.dbastrosuite.com
# Must be present when `pnpm build` runs (prebuilt deploys build locally).
VITE_CELESTORY_BASE_URL=

# HMAC secret signing owner-session tokens (edit/delete a published profile).
# REQUIRED in production — the server refuses to boot without it there.
# Generate one with: openssl rand -hex 32
CELESTORY_SESSION_SECRET=
